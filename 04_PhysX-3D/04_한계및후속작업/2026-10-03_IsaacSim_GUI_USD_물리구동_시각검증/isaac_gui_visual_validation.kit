[package]
title = "PhysX GT-only GUI visual validation"
description = "Minimal Isaac Sim GUI/viewport stage without ML or ROS extensions"
version = "1.0.0"

[dependencies]
"omni.kit.loop-isaac" = {}
"omni.usd" = {}
"omni.kit.usd.layers" = {}
"omni.kit.mainwindow" = {}
"omni.kit.uiapp" = {}
"omni.kit.window.stage" = {}
"omni.kit.window.property" = {}
"omni.kit.window.toolbar" = {}
"omni.kit.window.status_bar" = {}
"omni.kit.window.title" = {}
"omni.kit.window.console" = {}
"omni.kit.property.bundle" = {}
"omni.kit.selection" = {}
"omni.kit.viewport.bundle" = {}
"omni.kit.viewport.rtx" = {}
"omni.kit.viewport.actions" = {}
"omni.kit.manipulator.camera" = {}
"omni.kit.manipulator.prim" = {}
"omni.kit.manipulator.selection" = {}
"omni.kit.menu.common" = {}
"omni.kit.menu.stage" = {}
"omni.kit.renderer.core" = {}
"omni.hydra.engine.stats" = {}
"omni.hydra.rtx" = {}
"omni.physx" = {}
"omni.physics.physx" = {}
"omni.physics.stageupdate" = {}
"omni.physics.tensors" = {}
"isaacsim.core.simulation_manager" = {}

[settings]
app.name = "PhysX GT-only GUI visual validation"
app.window.title = "Isaac Sim 6.1 — GT-only visual validation"
app.window.width = 1440
app.window.height = 900
app.viewport.defaults.fillViewport = true
renderer.enabled = "rtx"
renderer.multiGpu.enabled = false
renderer.multiGpu.autoEnable = false
renderer.activeGpu = 0
physics.cudaDevice = 0
physics.enableGPUDynamics = true
physics.disableContactProcessing = false
app.fastShutdown = false

